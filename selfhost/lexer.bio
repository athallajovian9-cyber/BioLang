// BioLang's lexer, runnable.
//
// The logic lives in lexlib.bio so the parser can graft the same code rather
// than keeping a second copy. This file is just the entry point.
//
//   biolang selfhost/lexer.bio    (reads a path on stdin, prints the token stream)
organism BioLexerRunner {
    graft "lexlib.bio"

    nucleus() {
        cell rna path = absorb("source? ")
        cell rna src = readFile(path)
        cell colony toks = lex(src)
        traverse (cell dna k = 0; k < toks.length; k = k + 1) {
            cell Tok t = toks[k]
            secrete("  " + t.kind + "(" + t.text + ") at " + rna(t.line) + ":" + rna(t.col))
        }
    }
}
