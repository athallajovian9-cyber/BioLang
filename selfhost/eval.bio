// BioLang Evaluator (Interpreter Core) written in pure BioLang.
// Stage 3 of Self-Hosting.
//
// Walks the parsed program structure, manages runtime scopes, evaluates
// expressions, and executes statements in compliance with src/Interpreter.cs.

organism BioEvaluator {
    graft "parser.bio"

    // ------------------------------------------------------------------ Values
    // Representation of runtime values in BioLang
    // typeKind:
    //   0 = void
    //   1 = dna (number)
    //   2 = rna (string)
    //   3 = enzyme (boolean)
    //   4 = colony (list)
    membrane Val {
        dna kind
        dna numVal
        rna strVal
        enzyme boolVal
        colony listVal
    }

    organ makeVoid() -> Val {
        return Val { kind = 0, numVal = 0, strVal = "", boolVal = dormant, listVal = [] }
    }

    organ makeDna(dna n) -> Val {
        return Val { kind = 1, numVal = n, strVal = "", boolVal = dormant, listVal = [] }
    }

    organ makeRna(rna s) -> Val {
        return Val { kind = 2, numVal = 0, strVal = s, boolVal = dormant, listVal = [] }
    }

    organ makeEnzyme(enzyme b) -> Val {
        return Val { kind = 3, numVal = 0, strVal = "", boolVal = b, listVal = [] }
    }

    organ makeColony(colony l) -> Val {
        return Val { kind = 4, numVal = 0, strVal = "", boolVal = dormant, listVal = l }
    }

    // String representation matching C# Display()
    organ valDisplay(Val v) -> rna {
        mutate (v.kind == 0) { return "void" }
        adapt mutate (v.kind == 1) { return rna(v.numVal) }
        adapt mutate (v.kind == 2) { return v.strVal }
        adapt mutate (v.kind == 3) {
            mutate (v.boolVal) { return "active" }
            return "dormant"
        }
        adapt mutate (v.kind == 4) {
            cell rna out = "["
            traverse (cell dna i = 0; i < v.listVal.length; i = i + 1) {
                mutate (i > 0) { out = out + ", " }
                cell Val item = v.listVal[i]
                out = out + valDisplay(item)
            }
            return out + "]"
        }
        return ""
    }

    // Truthiness rule: enzyme is itself, dna is non-zero, rna is non-empty, colony non-empty
    organ isTruthy(Val v) -> enzyme {
        mutate (v.kind == 3) { return v.boolVal }
        adapt mutate (v.kind == 1) { return v.numVal != 0 }
        adapt mutate (v.kind == 2) { return v.strVal.length > 0 }
        adapt mutate (v.kind == 4) { return v.listVal.length > 0 }
        return dormant
    }

    // ------------------------------------------------------------------ Scopes
    membrane Binding {
        rna name
        Val val
        enzyme mutable
    }

    membrane Scope {
        colony bindings // colony of Binding
    }

    organ newScope() -> Scope {
        return Scope { bindings = [] }
    }

    organ defineVar(Scope s, rna name, Val v, enzyme mut) -> void {
        s.bindings.inject(Binding { name = name, val = v, mutable = mut })
    }

    organ lookupScope(Scope s, rna name) -> Val {
        traverse (cell dna i = s.bindings.length - 1; i >= 0; i = i - 1) {
            cell Binding b = s.bindings[i]
            mutate (b.name == name) {
                return b.val
            }
        }
        return makeVoid()
    }

    organ assignScope(Scope s, rna name, Val v) -> enzyme {
        traverse (cell dna i = s.bindings.length - 1; i >= 0; i = i - 1) {
            cell Binding b = s.bindings[i]
            mutate (b.name == name) {
                mutate (b.mutable == dormant) {
                    secrete("  RUNTIME ERROR: '" + name + "' is a fossil and cannot be reassigned")
                    cell dna zero = 0
                    dna err = zero / zero
                }
                b.val = v
                return active
            }
        }
        return dormant
    }

    // ------------------------------------------------------------------ Operations
    organ evalAdd(Val a, Val b) -> Val {
        mutate (a.kind == 1) {
            mutate (b.kind == 1) {
                return makeDna(a.numVal + b.numVal)
            }
        }
        mutate (a.kind == 2) {
            return makeRna(valDisplay(a) + valDisplay(b))
        }
        mutate (b.kind == 2) {
            return makeRna(valDisplay(a) + valDisplay(b))
        }
        mutate (a.kind == 4) {
            mutate (b.kind == 4) {
                cell colony combined = []
                traverse (cell dna i = 0; i < a.listVal.length; i = i + 1) {
                    combined.inject(a.listVal[i])
                }
                traverse (cell dna j = 0; j < b.listVal.length; j = j + 1) {
                    combined.inject(b.listVal[j])
                }
                return makeColony(combined)
            }
        }
        secrete("  RUNTIME ERROR: invalid operands for '+'")
        cell dna zero = 0
        dna err = zero / zero
        return makeVoid()
    }

    organ evalSub(Val a, Val b) -> Val {
        mutate (a.kind == 1) {
            mutate (b.kind == 1) {
                return makeDna(a.numVal - b.numVal)
            }
        }
        secrete("  RUNTIME ERROR: '-' requires numeric operands")
        cell dna zero = 0
        dna err = zero / zero
        return makeVoid()
    }

    organ evalMul(Val a, Val b) -> Val {
        mutate (a.kind == 1) {
            mutate (b.kind == 1) {
                return makeDna(a.numVal * b.numVal)
            }
        }
        secrete("  RUNTIME ERROR: '*' requires numeric operands")
        cell dna zero = 0
        dna err = zero / zero
        return makeVoid()
    }

    organ evalDiv(Val a, Val b) -> Val {
        mutate (a.kind == 1) {
            mutate (b.kind == 1) {
                mutate (b.numVal == 0) {
                    secrete("  RUNTIME ERROR: division by zero")
                    cell dna zero = 0
                    dna err = zero / zero
                }
                return makeDna(a.numVal / b.numVal)
            }
        }
        secrete("  RUNTIME ERROR: '/' requires numeric operands")
        cell dna zero = 0
        dna err = zero / zero
        return makeVoid()
    }

    organ evalEqual(Val a, Val b) -> Val {
        mutate (a.kind != b.kind) {
            return makeEnzyme(dormant)
        }
        mutate (a.kind == 0) { return makeEnzyme(active) }
        adapt mutate (a.kind == 1) { return makeEnzyme(a.numVal == b.numVal) }
        adapt mutate (a.kind == 2) { return makeEnzyme(a.strVal == b.strVal) }
        adapt mutate (a.kind == 3) { return makeEnzyme(a.boolVal == b.boolVal) }
        adapt mutate (a.kind == 4) {
            mutate (a.listVal.length != b.listVal.length) { return makeEnzyme(dormant) }
            traverse (cell dna i = 0; i < a.listVal.length; i = i + 1) {
                cell Val eq = evalEqual(a.listVal[i], b.listVal[i])
                mutate (eq.boolVal == dormant) { return makeEnzyme(dormant) }
            }
            return makeEnzyme(active)
        }
        return makeEnzyme(dormant)
    }

    organ evalLess(Val a, Val b) -> Val {
        mutate (a.kind == 1) {
            mutate (b.kind == 1) {
                return makeEnzyme(a.numVal < b.numVal)
            }
        }
        mutate (a.kind == 2) {
            mutate (b.kind == 2) {
                return makeEnzyme(a.strVal < b.strVal)
            }
        }
        secrete("  RUNTIME ERROR: '<' requires numbers or strings")
        cell dna zero = 0
        dna err = zero / zero
        return makeVoid()
    }

    nucleus() {
        secrete("BioLang Self-Hosting Evaluator (Stage 3) Initialized.")
        cell Scope s = newScope()
        defineVar(s, "x", makeDna(40), active)
        defineVar(s, "y", makeDna(2), dormant)
        defineVar(s, "name", makeRna("BioLang"), dormant)

        cell Val xVal = lookupScope(s, "x")
        cell Val yVal = lookupScope(s, "y")
        cell Val sumVal = evalAdd(xVal, yVal)
        secrete("x + y = " + valDisplay(sumVal))

        cell Val mulVal = evalMul(xVal, yVal)
        secrete("x * y = " + valDisplay(mulVal))

        cell Val eqVal = evalEqual(sumVal, makeDna(42))
        secrete("sum == 42 : " + valDisplay(eqVal))
    }
}
