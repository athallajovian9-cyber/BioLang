// BioLang Evaluator (Interpreter Core) written in pure BioLang.
// Stage 3 of Self-Hosting.

organism BioEvaluator {
    graft "evallib.bio"

    nucleus() {
        secrete("BioLang Self-Hosting Evaluator (Stage 3) Initialized.")
        cell Scope s = newScope()
        defineVar(s, "x", makeDna(40), active)
        defineVar(s, "y", makeDna(2), dormant)
        defineVar(s, "name", makeRna("BioLang"), dormant)

        cell Val xVal = lookupScope(s, "x")
        cell Val yVal = lookupScope(s, "y")
        cell Val sumVal = evalAdd(xVal, yVal)
        secrete("x + y = " + valDisplay(sumVal))

        cell Val mulVal = evalMul(xVal, yVal)
        secrete("x * y = " + valDisplay(mulVal))

        cell Val eqVal = evalEqual(sumVal, makeDna(42))
        secrete("sum == 42 : " + valDisplay(eqVal))
    }
}
